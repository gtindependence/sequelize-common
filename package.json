{
    "name": "@gtindependence/sequelize-common",
    "version": "16.0.0",
    "description": "A common set of models and functions that we use throughout most of our Sequelize projects",
    "keywords": [
        "Typescript"
    ],
    "author": "TeamMaestro + GTIndependence",
    "homepage": "https://github.com/gtindependence/sequelize-common",
    "repository": {
        "type": "git",
        "url": "https://github.com/gtindependence/sequelize-common.git"
    },
    "bugs": {
        "url": "https://github.com/gtindependence/sequelize-common/issues"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "modules/**/*.js",
        "modules/**/*.d.ts"
    ],
    "license": "ISC",
    "scripts": {
        "test": "jest",
        "watch": "tsc -w",
        "start": "npm run watch",
        "clean": "rm -f *.js && rm -f *.d.ts && rm -Rf modules",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "prepack": "npm run lint && npm run build",
        "postpack": "npm run clean",
        "postpublish": "git push && git push --tags",
        "pack:dev": "npm pack",
        "postpack:dev": "npm run build && mkdir -p ./build && mv ./*.tgz ./build && echo \"\nPack file path:\n$(pwd)/build/$(ls -tp ./build | grep -v '/$' | head -n 1)\n\"",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --check src"
    },
    "peerDependencies": {
        "@gtindependence/nestjs-common": "24.0.0",
        "moment": "2.31.0",
        "reflect-metadata": "^0.1.13",
        "sequelize": "^6.33.0",
        "sequelize-typescript": "^2.1.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@gtindependence/nestjs-common": "24.0.0",
        "@gtindependence/node-common": "7.1.0",
        "@nestjs/common": "^11.2.8",
        "@nestjs/core": "^11.2.8",
        "@nestjs/microservices": "^11.2.8",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/testing": "^11.2.8",
        "@types/jest": "^30.0.0",
        "@types/moment": "^2.13.0",
        "@types/validator": "^10.11.3",
        "class-validator": "^0.14.0",
        "config": "^3.3.9",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-plugin-import-x": "^4.17.1",
        "jest": "^30.5.2",
        "log4js": "^6.9.1",
        "moment": "2.31.0",
        "passport": "^0.6.0",
        "prettier": "^3.9.10",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "sequelize": "^6.33.0",
        "sequelize-typescript": "^2.1.5",
        "ts-jest": "^29.4.15",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.72.0"
    },
    "dependencies": {
        "deepmerge-ts": "^8.0.2"
    },
    "peerDependenciesMeta": {
        "@gtindependence/nestjs-common": {
            "optional": true
        }
    }
}
